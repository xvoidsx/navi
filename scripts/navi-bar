#!/usr/bin/env bash
# navi-bar — choose where the Navi bar (waybar) sits.
#
# Waybar supports all four edges natively; this command is the switch.
#
#   navi-bar                  show the current position
#   navi-bar top|bottom|left|right [--force]
#                             move the bar (live, no re-login)
#   navi-bar apply            re-apply the saved position (the installer
#                             calls this after a deploy; never forces a
#                             hand-customized config)
#   navi-bar --help
#
# How it works:
# - the position is saved in ~/.local/share/navi/waybar/position.
# - the live config (~/.config/waybar/config.jsonc) is GENERATED from a
#   stock template: waybar/config.jsonc for top/bottom, and
#   waybar/config-vertical.jsonc for left/right (the rail design: launcher,
#   workspaces, time, status — no window title, no nowplaying, text modules
#   rotated so they read down the bar). The generated file carries a marker
#   comment; a live config without the marker that also differs from both
#   stock templates is treated as hand-customized and is never overwritten
#   without --force. Customized configs are sacred.
# - the live style.css is composed from the current theme plus a vertical
#   fragment (waybar/positions/vertical-<side>.css) when the bar is
#   vertical. navi-theme knows about the fragment too, so switching themes
#   keeps the bar vertical — and switching back to top/bottom strips it.
# - the bar is fully restarted (systemctl restart waybar.service), not
#   SIGUSR2 — GTK does not re-trigger @keyframes after a CSS hot-reload,
#   so a signal would silently lose the theme's animations.
#
# Revert: navi-bar top
# Rotate direction: left uses rotate 270 (letter-tops toward the desktop),
# right uses 90. If it reads wrong on your hardware, say so — it is one
# number in the generator, not a redesign. (2026-11-28: Waybar's rotate:90
# is counterclockwise, not clockwise — the first build read bottom-to-top.)

set -uo pipefail

WAYBAR_DIR="${WAYBAR_DIR:-$HOME/.config/waybar}"
SYS_BAR="${NAVI_BAR_SYS:-/usr/share/navi/waybar}"
USER_POS="${NAVI_BAR_POSITIONS:-$HOME/.local/share/navi/waybar/positions}"
SYS_POS="$SYS_BAR/positions"
USER_THEMES="${NAVI_THEMES_USER:-$HOME/.local/share/navi/waybar/themes}"
SYS_THEMES="${NAVI_THEMES_SYS:-/usr/share/navi/waybar/themes}"
STATE_FILE="${NAVI_BAR_STATE:-$HOME/.local/share/navi/waybar/position}"
CONFIG="$WAYBAR_DIR/config.jsonc"
STYLE="$WAYBAR_DIR/style.css"
MARKER="generated by navi-bar"

die() { printf 'navi-bar: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

valid_pos() {
    case "$1" in top|bottom|left|right) return 0 ;; *) return 1 ;; esac
}

is_vertical() {
    case "$1" in left|right) return 0 ;; *) return 1 ;; esac
}

# ------------------------------------------------------------------ lookup --

# The vertical fragment for a position: a user fragment of the same name
# shadows the distro one, mirroring how navi-theme resolves themes.
position_fragment() { # <pos> — prints the fragment path, or nothing
    is_vertical "$1" || return 0
    local f="vertical-$1.css"
    [ -f "$USER_POS/$f" ] && { printf '%s\n' "$USER_POS/$f"; return; }
    [ -f "$SYS_POS/$f" ] && { printf '%s\n' "$SYS_POS/$f"; return; }
    return 0
}

# The theme file for a named theme: user shadows system, like navi-theme.
theme_file() { # <name> — prints the theme.css path, or nothing
    [ -f "$USER_THEMES/$1/theme.css" ] && { printf '%s\n' "$USER_THEMES/$1/theme.css"; return; }
    [ -f "$SYS_THEMES/$1/theme.css" ] && { printf '%s\n' "$SYS_THEMES/$1/theme.css"; return; }
    return 0
}

current_theme_name() {
    command -v navi-theme >/dev/null 2>&1 || { printf 'custom\n'; return; }
    navi-theme current 2>/dev/null || printf 'custom\n'
}

current_position() {
    local p
    p=$(sed -n 's/^[[:space:]]*"position":[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" 2>/dev/null | head -1)
    valid_pos "${p:-}" && printf '%s\n' "$p" || printf 'top\n'
}

# ------------------------------------------------------------------ guards --

live_is_generated() { grep -q "$MARKER" "$CONFIG" 2>/dev/null; }

live_is_stock() {
    cmp -s "$CONFIG" "$SYS_BAR/config.jsonc" 2>/dev/null && return 0
    cmp -s "$CONFIG" "$SYS_BAR/config-vertical.jsonc" 2>/dev/null && return 0
    return 1
}

# ---------------------------------------------------------------- generate --

# Generate the live config from the stock template for <pos>, with the
# position, margins and (for a right-side bar) rotate direction applied.
# Writes to $2; validates the JSONC parses before returning.
generate_config() { # <pos> <out>
    local pos="$1" out="$2" template
    if is_vertical "$pos"; then
        template="$SYS_BAR/config-vertical.jsonc"
    else
        template="$SYS_BAR/config.jsonc"
    fi
    [ -f "$template" ] || die "no stock template at $template — run navi-update first"
    python3 - "$pos" "$template" "$out" <<'PY'
import re, sys, json
pos, src, out = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(src).read()
text = re.sub(r'"position":\s*"[^"]*"', '"position": "%s"' % pos, text, count=1)
margins = {
    'top':    {'margin-top': 8,  'margin-bottom': 0, 'margin-left': 10, 'margin-right': 10},
    'bottom': {'margin-top': 0,  'margin-bottom': 8, 'margin-left': 10, 'margin-right': 10},
    'left':   {'margin-top': 10, 'margin-bottom': 10, 'margin-left': 8, 'margin-right': 0},
    'right':  {'margin-top': 10, 'margin-bottom': 10, 'margin-left': 0, 'margin-right': 8},
}[pos]
for key, val in margins.items():
    text = re.sub(r'"%s":\s*\d+' % key, '"%s": %d' % (key, val), text, count=1)
if pos == 'right':
    # left is the vertical template's default; a right-side bar reads
    # the other way (letter-tops toward the desktop).
    text = re.sub(r'"rotate":\s*270', '"rotate": 90', text)
text = ('// generated by navi-bar (%s) — edit wired/waybar/config*.jsonc '
        'instead, then run: navi-bar %s\n' % (pos, pos)) + text
# validate: the config carries no // or /* */ inside strings, so a plain
# comment strip is a faithful parse check.
stripped = re.sub(r'/\*.*?\*/', '', text, flags=re.S)
stripped = re.sub(r'//[^\n]*', '', stripped)
json.loads(stripped)
open(out, 'w').write(text)
PY
}

# Compose the live style.css: the current theme, plus the vertical fragment
# when the bar is vertical. Any fragment already in the file (from a
# previous position) is stripped first, so switching sides or going back
# to the top never stacks fragments. Writes to $2.
compose_style() { # <pos> <out>
    local pos="$1" out="$2" theme frag base
    theme=$(current_theme_name)
    frag=$(position_fragment "$pos")
    if [ "$theme" != custom ]; then
        base=$(theme_file "$theme") || base=""
    fi
    if [ -n "${base:-}" ]; then
        # Plain concatenation, byte-identical to navi-theme's compose_theme
        # — navi-theme current matches style.css against theme+fragment,
        # so the two composers must produce the same bytes. (All theme
        # files end with a newline, so the fragment never runs onto the
        # theme's last line.)
        python3 - "$base" "$frag" "$out" <<'PY'
import sys
base, frag, out = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(base).read()
if frag:
    text += open(frag).read()
open(out, 'w').write(text)
PY
    else
        # custom theme: keep the user's own style.css, only swap the
        # fragment in or out.
        python3 - "$STYLE" "$frag" "$out" <<'PY'
import re, sys
style, frag, out = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(style).read()
text = re.sub(r'/\* === navi-bar: vertical fragment.*?— end === \*/',
              '', text, flags=re.S)
text = text.rstrip() + '\n'
if frag:
    text += '\n' + open(frag).read()
open(out, 'w').write(text)
PY
    fi
}

# GTK3 rejects comma selector lists inside @keyframes and renders
# `transparent` as a dark fringe, so a broken stylesheet can take the whole
# bar down. Validate before installing, not after. (Same check navi-theme
# runs; copied, not shared — navi-theme is a command, not a library.)
validate_css() {
    python3 - "$1" <<'PY' 2>/dev/null
import sys
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

errs = []
p = Gtk.CssProvider()

def on_err(provider, section, error):
    try:
        line = int(error.start_location[1]) + 1
        errs.append("  line %d: %s" % (line, error.message))
    except Exception:
        errs.append("  %s" % error.message)

p.connect("parsing-error", on_err)
try:
    p.load_from_path(sys.argv[1])
except Exception as e:
    errs.append("  %s" % e)

for e in errs:
    print(e)
sys.exit(1 if errs else 0)
PY
}

reload_bar() {
    # Full restart, not SIGUSR2: GTK does not re-trigger @keyframes on
    # already-rendered widgets after a CSS hot-reload, so a position
    # switch via SIGUSR2 would silently lose the theme's animations.
    # systemd manages the service on navi, so restart through it; fall
    # back to kill+start if not.
    if systemctl --user is-active -q waybar.service 2>/dev/null; then
        systemctl --user restart waybar.service 2>/dev/null || true
    else
        pkill -x waybar 2>/dev/null || true
        sleep 0.5
        ( waybar -b bar-0 >/dev/null 2>&1 & )
        disown 2>/dev/null || true
    fi
}

# -------------------------------------------------------------------- apply --

apply_position() { # <pos> [--force] — the explicit user command
    local pos="$1" force=0
    [ "${2:-}" = "--force" ] && force=1
    valid_pos "$pos" || die "unknown position '$pos' (top, bottom, left, right)"

    if [ -e "$CONFIG" ] && [ "$force" -eq 0 ]; then
        if ! live_is_generated && ! live_is_stock; then
            die "live config looks hand-customized — back it up, or run: navi-bar $pos --force"
        fi
    fi

    local cfg_tmp="$CONFIG.tmp.$$" sty_tmp="$STYLE.tmp.$$" out
    generate_config "$pos" "$cfg_tmp" || { rm -f "$cfg_tmp"; die "could not generate the $pos config"; }
    compose_style "$pos" "$sty_tmp"
    if ! out=$(validate_css "$sty_tmp" 2>&1); then
        rm -f "$cfg_tmp" "$sty_tmp"
        printf '%s\n' "$out" >&2
        die "composed stylesheet is invalid — bar left on '$(current_position)'"
    fi

    # Atomic writes: waybar reading a partially-written file gets a
    # truncated config and a broken bar. Write temp + rename instead.
    # No reload when nothing changed — re-applying the same position
    # should not flash the bar.
    local changed=0
    cmp -s "$cfg_tmp" "$CONFIG" 2>/dev/null || changed=1
    cmp -s "$sty_tmp" "$STYLE" 2>/dev/null || changed=1
    mkdir -p "$WAYBAR_DIR"
    mv -f "$cfg_tmp" "$CONFIG"
    mv -f "$sty_tmp" "$STYLE"
    rm -f "$cfg_tmp" "$sty_tmp"

    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s\n' "$pos" > "$STATE_FILE.tmp.$$" && mv -f "$STATE_FILE.tmp.$$" "$STATE_FILE"

    [ "$changed" -eq 1 ] && reload_bar

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "navi-bar" -u low -t 2200 "navi-bar: $pos" \
            "the bar is on the $pos edge" 2>/dev/null || true
    fi
    say "$pos"
}

apply_saved() {
    # The deploy hook: re-apply the saved position after install.sh
    # deploys fresh stock templates. Best effort — never fail a deploy,
    # never touch a hand-customized config.
    [ -f "$STATE_FILE" ] || return 0
    local pos; pos=$(cat "$STATE_FILE" 2>/dev/null | head -1)
    valid_pos "${pos:-}" || { say "navi-bar: saved position '$pos' is not valid — leaving the bar alone"; return 0; }
    if [ -e "$CONFIG" ] && ! live_is_generated && ! live_is_stock; then
        say "navi-bar: live config looks hand-customized — leaving it alone (run: navi-bar $pos to force)"
        return 0
    fi

    local cfg_tmp="$CONFIG.tmp.$$" sty_tmp="$STYLE.tmp.$$" out
    generate_config "$pos" "$cfg_tmp" 2>/dev/null || { rm -f "$cfg_tmp"; return 0; }
    compose_style "$pos" "$sty_tmp" 2>/dev/null || { rm -f "$cfg_tmp" "$sty_tmp"; return 0; }
    if ! out=$(validate_css "$sty_tmp" 2>&1); then
        rm -f "$cfg_tmp" "$sty_tmp"
        say "navi-bar: composed stylesheet is invalid — leaving the bar alone"
        return 0
    fi

    local changed=0
    cmp -s "$cfg_tmp" "$CONFIG" 2>/dev/null || changed=1
    cmp -s "$sty_tmp" "$STYLE" 2>/dev/null || changed=1
    mkdir -p "$WAYBAR_DIR"
    mv -f "$cfg_tmp" "$CONFIG"
    mv -f "$sty_tmp" "$STYLE"
    rm -f "$cfg_tmp" "$sty_tmp"
    if [ "$changed" -eq 1 ] && pgrep -x waybar >/dev/null 2>&1; then
        reload_bar
    fi
    [ "$changed" -eq 1 ] && say "navi-bar: re-applied saved position ($pos)"
    return 0
}

# --------------------------------------------------------------------- cli ---

cmd="${1:-}"

case "$cmd" in
    ""|show)  current_position ;;
    top|bottom|left|right)
        apply_position "$cmd" "${2:-}"
        ;;
    apply)  apply_saved ;;
    -h|--help|help)
        sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *) die "unknown command '$cmd' (try: navi-bar --help)" ;;
esac
