// nightshadeNeon - rofi config for navi
// ( this file should live at $HOME/.config/rofi/config.rasi )
configuration {
    modi: "combi";
    combi-modi: "window,drun,run";
    font: "Noto Sans 12";
    show-icons: true;
    icon-theme: "Papirus";
    display-window: "Windows";
    display-drun: "Apps";
    display-run: "Run";
    sidebar-mode: false;
    kb-mode-next: "Control+Tab";
    kb-mode-previous: "Control+Shift+Tab";
    kb-accept-entry: "Return";
    kb-cancel: "Escape";
}

* {
    background: #000000e6;
    background-solid: #000000;
    foreground: #ff10f0;
    accent: #ff10f0;
    neon-green: #39ff14;
    neon-cyan: #00ffff;
    neon-red: #ff3131;
    neon-white: #ffffff;
    text-color: #ff10f0;
    border-color: #ff10f0;
    selected-background: #2a0a28;
    selected-foreground: #39ff14;
}

window {
    background-color: @background;
    border: 2;
    border-color: @border-color;
    padding: 12;
    width: 720px;
}

mainbox {
    background-color: @background;
    border: 1;
    border-color: @neon-green;
    padding: 8;
    spacing: 8;
}

inputbar {
    background-color: @background-solid;
    text-color: @foreground;
    border: 1;
    border-color: @border-color;
    padding: 8px;
    spacing: 8px;
}

prompt {
    background-color: @background-solid;
    text-color: @foreground;
}

entry {
    background-color: @background-solid;
    text-color: @neon-white;
    placeholder-color: #8a8a8a;
}

listview {
    background-color: @background;
    border: 0;
    padding: 4px;
    spacing: 2px;
    scrollbar: false;
    lines: 12;
}

scrollbar {
    background-color: @background;
    handle-color: @neon-green;
    handle-width: 4px;
}

element {
    background-color: @background;
    text-color: @foreground;
    border: 1;
    border-color: @background;
    padding: 5px 10px;
}

element selected {
    background-color: @selected-background;
    text-color: @selected-foreground;
    border: 1;
    border-color: @neon-green;
}

element selected.normal {
    background-color: @selected-background;
    text-color: @selected-foreground;
    border: 1;
    border-color: @neon-green;
}

element selected.active {
    background-color: @selected-background;
    text-color: @neon-cyan;
    border: 1;
    border-color: @neon-cyan;
}

element selected.urgent {
    background-color: @selected-background;
    text-color: @neon-red;
    border: 1;
    border-color: @neon-red;
}

element normal {
    background-color: @background;
    text-color: @foreground;
}

element alternate.normal {
    background-color: #0d0d0d;
    text-color: @foreground;
}

element alternate.active {
    background-color: #0d0d0d;
    text-color: @neon-cyan;
}

element alternate.urgent {
    background-color: #0d0d0d;
    text-color: @neon-red;
}

element active {
    background-color: @background;
    text-color: @neon-cyan;
}

element urgent {
    background-color: @background;
    text-color: @neon-red;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    highlight: @neon-cyan;
}

element-icon {
    background-color: inherit;
    size: 22px;
    padding: 0 8px 0 0;
}

message {
    background-color: @background-solid;
    border: 1;
    border-color: @neon-red;
    padding: 8px;
}

textbox {
    background-color: @background-solid;
    text-color: @neon-white;
}

button selected {
    background-color: @selected-background;
    text-color: @selected-foreground;
    border: 1;
    border-color: @neon-green;
}
