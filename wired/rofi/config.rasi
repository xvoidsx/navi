// wired nightshade launcher
// this is the default launcher used to launch apps and run commands in navi.
// beautiful and drenched in nightshadeNeon.
// this file should live at ( $HOME/.config/rofi/config.rasi )

configuration {
    modi: "combi";
    combi-modi: "window,drun,run";
    font: "Fira Sans, Inter 12";
    show-icons: true;
    icon-theme: "Papirus";
    display-window: "Windows";
    display-drun: "Apps";
    display-run: "Run";
    sidebar-mode: false;
    kb-mode-next: "Control+Tab";
    kb-mode-previous: "Control+Shift+Tab";
    kb-accept-entry: "Return";
    kb-cancel: "Escape";
}

* {
    background: #000000cf;
    background-solid: #000000eb;
    glass-surface: #120510d4;
    glass-deep: #050005e8;
    glass-edge: #39ff1499;
    glass-highlight: #ffffff22;
    neon-pink: #ff10f0;
    foreground: #ff10f0;
    accent: #ff10f0;
    neon-green: #39ff14;
    neon-cyan: #00ffff;
    neon-red: #ff3131;
    neon-white: #ffffff;
    text-color: #ff10f0;
    border-color: #ff10f0;
    selected-background: #2a0a28dc;
    selected-foreground: #39ff14;
}

window {
    background-color: @background;
    border: 1;
    border-color: @glass-edge;
    border-radius: 16px;
    padding: 14;
    width: 720px;
}

mainbox {
    background-color: @glass-surface;
    border: 1;
    border-color: @glass-highlight;
    border-radius: 11px;
    padding: 9;
    spacing: 8;
}

inputbar {
    background-color: @glass-deep;
    text-color: @foreground;
    border: 1;
    border-color: @neon-pink;
    border-radius: 9px;
    padding: 8px;
    spacing: 8px;
}

prompt {
    background-color: @glass-deep;
    text-color: @foreground;
}

entry {
    background-color: @glass-deep;
    text-color: @neon-white;
    placeholder-color: #8a8a8a;
}

listview {
    background-color: transparent;
    border: 0;
    padding: 4px;
    spacing: 2px;
    scrollbar: false;
    lines: 12;
}

scrollbar {
    background-color: @glass-deep;
    handle-color: @neon-green;
    handle-width: 4px;
}

element {
    background-color: transparent;
    text-color: @neon-white;
    border: 1;
    border-color: transparent;
    border-radius: 8px;
    padding: 5px 10px;
}

element selected {
    background-color: @selected-background;
    text-color: @selected-foreground;
    border: 1;
    border-color: @neon-green;
}

element selected.normal {
    background-color: @selected-background;
    text-color: @selected-foreground;
    border: 1;
    border-color: @neon-green;
}

element selected.active {
    background-color: @selected-background;
    text-color: @neon-cyan;
    border: 1;
    border-color: @neon-cyan;
}

element selected.urgent {
    background-color: @selected-background;
    text-color: @neon-red;
    border: 1;
    border-color: @neon-red;
}

element normal {
    background-color: transparent;
    text-color: @neon-white;
}

element alternate.normal {
    background-color: #12051099;
    text-color: @neon-white;
}

element alternate.active {
    background-color: #12051099;
    text-color: @neon-cyan;
}

element alternate.urgent {
    background-color: #12051099;
    text-color: @neon-red;
}

element active {
    background-color: transparent;
    text-color: @neon-cyan;
}

element urgent {
    background-color: transparent;
    text-color: @neon-red;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    highlight: @neon-cyan;
}

element-icon {
    background-color: inherit;
    size: 22px;
    padding: 0 8px 0 0;
}

message {
    background-color: @glass-deep;
    border: 1;
    border-color: @neon-red;
    padding: 8px;
}

textbox {
    background-color: @glass-deep;
    text-color: @neon-white;
}

button selected {
    background-color: @selected-background;
    text-color: @selected-foreground;
    border: 1;
    border-color: @neon-green;
}
