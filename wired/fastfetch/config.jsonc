{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "${c1}            ██████\n${c1}         ████    ████\n${c1}        ███      ${c3}╱╱${c1}███\n${c1}        ██    ${c3}╱╱${c1}    ██\n${c1}        ███${c3}╱╱${c1}      ███\n${c1}         ████    ████\n${c1}            ██████",
    "color": {
      "1": "magenta",
      "2": "blue",
      "3": "cyan",
      "4": "magenta"
    }
  },
  "display": {
    "separator": "  ➜  ",
    "color": {
      "keys": "magenta",
      "title": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
