{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1            ██████\n$1         ████    ████\n$1        ███      $3╱╱$1███\n$1        ██    $3╱╱$1    ██\n$1        ███$3╱╱$1      ███\n$1         ████    ████\n$1            ██████",
    "color": {
      "1": "magenta",
      "3": "cyan"
    }
  },
  "display": {
    "color": {
      "keys": "magenta",
      "title": "cyan"
    },
    "separator": "  ➜  "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
