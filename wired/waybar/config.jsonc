// -*- mode: json -*-
// waybar config for wiredWM
//	- by rav3ndust
// this file should also live at /etc/xdg/waybar/config
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-bottom": 0,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 2,

    "modules-left": [
        "custom/wired-launcher",
        "sway/workspaces",
        "sway/window"
    ],
    "modules-center": [
        "clock#1",
        "clock#2",
        "clock#3"
    ],
    "modules-right": [
        //"custom/media",
	"custom/weather",
	"custom/update",
	"pulseaudio",
        "network",
        "battery",
        "backlight",
        "idle_inhibitor",
        "power-profiles-daemon",
	"custom/bell",
	"tray",
	"custom/power"
    ],

    "sway/workspaces": {
        "disable-scroll": false,
        // XXX testing roman numerals as workspace numbers.
		//"format": "{name}"
		"format": "{icon}",
		"format-icons": {
			"1": "I",
			"2": "II",
			"3": "III",
			"4": "IV",
			"5": "V",
			"6": "VI",
			"7": "VII",
			"8": "VIII",
			"9": "IX",
			"10": "X"
		}
    },

    "clock#1": {
        "format": "{:%A}",
        "tooltip": false,
        "on-click": "alacritty -e calcurse"
    },
    "clock#2": {
        "format": "{:%H:%M}",
        "tooltip": false,
        "on-click": "alacritty -e tty-clock"
    },
    "clock#3": {
        //"format": "{:%Y/%m/%d}",
        "format": "{:%d %B}",
	"tooltip": false,
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-calendar\" navi-calendar"
    },

    "pulseaudio": {
        "format": "🔊 {volume:2}%",  // Added volume character
        "format-bluetooth": "🔊 Volume {volume}% ",
        "format-muted": "🔇 mute",  // Added mute character
        "format-icons": {
            "headphones": "🎧",
            "default": [
                "🔊",
                "🔈"
            ]
        },
        "scroll-step": 5,
        "on-click": "pamixer -t",
        "on-click-right": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-audio\" navi-audio"
    },
    // - - - XXX testing section XXX - - -
    // this is a 'testing' network module. if it doesn't work out right, we'll remove it
    "network": {
            "format-wifi": "📶 {signalStrength}%",
            "format-ethernet": "🌐 {ifname}",
            "format-disconnected": "⚠ Disconnected",
            "tooltip-format": "Wireless status -  {ifname}: {ipaddr}/{cidr}",
	    "tooltip-format-wifi": "{essid}",
            "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-networking\" navi-networking",
            "interval": 30
        },
    // this is a 'testing' audioplayer module. shows currently playing audio and is interactive.
    "custom/media": {
	    "format": "{}",
	    "return-type": "json",
	    "max-length": 20,
	    "fixed-width": true,
	    "escape": true,
	    "exec": "/usr/local/bin/mediaplayer.sh",
	    "on-click": "playerctl play-pause",
	    "interval": 1
    },
    // - - - XXX end testing section XXX - - -
    "memory": {
        "interval": 5,
        "format": "Mem {}%"
    },
    "cpu": {
        "interval": 5,
        "format": "CPU {usage:2}%"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "disk": {
        "interval": 5,
        "format": "Disk {percentage_used:2}%",
        "path": "/"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 6
    },
    "custom/wired-launcher": {
        //"format": "▽",
        "format": "∅",
	"on-click": "rofi -show combi -combi -modi window,drun,run modi combi",
        "tooltip": true,
		"tooltip-format": "open Wired launcher"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "backlight": {
        "format": "{percent}% {icon}",
		"tooltip": true,
		"tooltip-format": "Brightness control",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "custom/update": {
        "format": "{}",
        "return-type": "json",
        "escape": true,
        "interval": 300,
        "exec": "/usr/share/navi/wired/waybar/update-check.sh",
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-update\" navi-update",
        "tooltip": true
    },
    "custom/weather": {
        "format": "{}",
        "return-type": "json",
        "escape": true,
        "interval": 600,
        "exec": "/usr/share/navi/wired/waybar/weather.sh",
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi weather\" navi-weather",
        "tooltip": true
    },
    "custom/bell": {
        "format": "{}",
        "return-type": "json",
        "escape": true,
        "interval": 10,
        "exec": "/usr/share/navi/wired/waybar/notif-bell.sh",
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-notifs\" navi-notifs",
        "tooltip": true
    },
    "custom/power": {
        "format" : "⏻ ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/usr/share/waybar/custom_modules/power_menu.xml",
        "menu-actions": {
            "shutdown": "sh -c 'systemctl poweroff'",
            "reboot": "systemctl reboot",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    }
}
