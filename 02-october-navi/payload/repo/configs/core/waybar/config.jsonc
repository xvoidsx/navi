// -*- mode: json -*-
// waybar config for wiredWM
//	- by rav3ndust
// this file should also live at /etc/xdg/waybar/config
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-bottom": 0,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 2,

    "modules-left": [
        "custom/wired-launcher",
        "sway/workspaces",
        "sway/window"
    ],
    "modules-center": [
        "clock#1",
        "clock#2",
        "clock#3"
    ],
    "modules-right": [
	"custom/weather",
	"custom/update",
	"custom/volume",
        "network",
        "bluetooth",
        "battery",
        "backlight",
        "idle_inhibitor",
        "power-profiles-daemon",
	"custom/agent",
	"custom/bell",
	"tray",
	"custom/power"
    ],

    "sway/workspaces": {
        "disable-scroll": false,
        // XXX testing roman numerals as workspace numbers.
		//"format": "{name}"
		"format": "{icon}",
		"format-icons": {
			"1": "I",
			"2": "II",
			"3": "III",
			"4": "IV",
			"5": "V",
			"6": "VI",
			"7": "VII",
			"8": "VIII",
			"9": "IX",
			"10": "X"
		}
    },

    "clock#1": {
        "format": "{:%A}",
        "tooltip": false,
        "on-click": "alacritty -e calcurse"
    },
    "clock#2": {
        "format": "{:%H:%M}",
        "tooltip": false,
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-reminders\" navi-reminders"
    },
    "clock#3": {
        //"format": "{:%Y/%m/%d}",
        "format": "{:%d %B}",
	"tooltip": false,
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-calendar\" navi-calendar"
    },

    "custom/volume": {
        // navi-audio volume module: live volume ("🔊 74%"). the device
        // label ("Line Out", "HDMI", …) lives in the tooltip so the module
        // stays compact. audio-status.sh is long-running and re-emits on
        // `pactl subscribe` events — no polling.
        "format": "{}",
        "return-type": "json",
        "exec": "/usr/share/navi/wired/waybar/audio-status.sh",
        "on-click": "pamixer -t",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5",
        "on-click-right": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-audio\" navi-audio",
        "on-click-middle": "/usr/share/navi/wired/waybar/audio-switch.sh",
        "tooltip": true
    },
    // - - - XXX testing section XXX - - -
    // this is a 'testing' network module. if it doesn't work out right, we'll remove it
    "network": {
            "format-wifi": "📶 {signalStrength}%",
            "format-ethernet": "🌐 {ifname}",
            "format-disconnected": "⚠ Disconnected",
            "tooltip-format": "Wireless status -  {ifname}: {ipaddr}/{cidr}",
	    "tooltip-format-wifi": "{essid}",
            "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-networking\" navi-networking",
            "interval": 30
        },
    // Bluetooth — the bar's Bluetooth indicator, replacing the blueman applet.
    //
    // blueman-tray was a legacy X11 XEmbed tray host. On this pure-Wayland
    // session it has no X display to reparent icons onto, so it never mapped a
    // window: `xlsclients` on :1 reports zero clients and BlueZ's
    // RegisteredStatusNotifierItems list is empty. It held ~77 MB while showing
    // nothing. Waybar's own `bluetooth` module reads org.bluez over D-Bus, so it
    // needs no PipeWire BlueZ plugin (that plugin is only required for BT *audio*
    // profiles, a separate install).
    //
    // The glyph is the bluetooth mark itself so it is unmistakably bluetooth,
    // followed by an explicit state dot: ● filled = a device is connected,
    // ○ hollow = radio up but nothing connected, … = mid-connection. Colour in
    // style.css (#bluetooth.off / .connected / .connecting) reinforces it, but
    // the dot carries the state on its own so it survives any restyle.
    //
    // NOTE: waybar 0.12.0 on this box hard-crashes the entire bar
    // ("argument not found") on the device-enumeration placeholders —
    // {device_count}, {device_enumerate}, {device_alias}, {device_address} and
    // {status_alias} all abort startup when no device is paired. {icon} and
    // {status} are safe, so the state is expressed with literal per-state format
    // strings instead. Revisit once a device is paired or waybar is past 0.12.0.
    "bluetooth": {
        "format": "{icon} 󰁨",
        "format-icons": {
            "off": "󰊓",
            "on": "󰊓",
            "connected": "󰊓",
            "disconnected": "󰊓"
        },
        "format-off": "{icon} 󰀍",
        "format-on": "{icon} 󰁨",
        "format-connecting": "{icon} 󰅁",
        "format-connected": "{icon} 󰃧",
        "format-disconnected": "{icon} 󰁨",
        "tooltip-format": "{status}",
        "on-click": "blueman-manager",
        "on-scroll-up": "bluetoothctl power on",
        "on-scroll-down": "bluetoothctl power off",
        "tooltip": true
    },
    // now playing: fixed-width slot showing what's on the MPRIS bus.
    // click opens the full navi-nowplaying mod.
    "custom/nowplaying": {
        "format": "{}",
        "return-type": "json",
        "max-length": 22,
        "fixed-width": true,
        "escape": true,
        "exec": "/usr/share/navi/wired/waybar/waybar-nowplaying.sh",
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi now playing\" navi-nowplaying",
        "interval": 2,
        "tooltip": true
    },
    "memory": {
        "interval": 5,
        "format": "Mem {}%"
    },
    "cpu": {
        "interval": 5,
        "format": "CPU {usage:2}%"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "disk": {
        "interval": 5,
        "format": "Disk {percentage_used:2}%",
        "path": "/"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 6
    },
    "custom/wired-launcher": {
        //"format": "▽",
        "format": "∅",
	"on-click": "rofi -show combi -combi -modi window,drun,run modi combi",
        "tooltip": true,
		"tooltip-format": "open Wired launcher"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "backlight": {
        "format": "{percent}% {icon}",
		"tooltip": true,
		"tooltip-format": "Brightness control",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "custom/update": {
        "format": "{}",
        "return-type": "json",
        "escape": true,
        "interval": 300,
        "exec": "/usr/share/navi/wired/waybar/update-check.sh",
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-update\" /usr/share/navi/wired/waybar/navi-update-click.sh",
        "tooltip": true
    },
    "custom/weather": {
        "format": "{}",
        "return-type": "json",
        "escape": true,
        "interval": 600,
        "exec": "/usr/share/navi/wired/waybar/weather.sh",
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi weather\" navi-weather",
        "tooltip": true
    },
    "custom/bell": {
        "format": "{}",
        "return-type": "json",
        "escape": true,
        "interval": 10,
        "exec": "/usr/share/navi/wired/waybar/notif-bell.sh",
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-notifs\" navi-notifs",
        "tooltip": true
    },
    "custom/agent": {
        "format": "{}",
        "return-type": "json",
        "escape": true,
        "interval": 5,
        "exec": "/usr/share/navi/wired/waybar/agent-mod.sh",
        "on-click": "/usr/share/navi/wired/waybar/mod-open.sh \"navi-agents-config\" navi-agents-config",
        "on-click-right": "/usr/share/navi/wired/waybar/agent-menu.sh",
        "on-click-middle": "/usr/share/navi/wired/waybar/mod-open.sh \"herdr\" herdr",
        "tooltip": true
    },
    "custom/power": {
        "format" : "⏻ ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/usr/share/waybar/custom_modules/power_menu.xml",
        "menu-actions": {
            "shutdown": "sh -c 'systemctl poweroff'",
            "reboot": "systemctl reboot",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    }
}
