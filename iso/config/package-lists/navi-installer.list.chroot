# navi-installer.list.chroot — extra packages inside the installer ISO.
#
# The ISO is a minimal live environment whose only job is running
# /usr/local/bin/navi-install: network, partition, encrypt, debootstrap,
# and hand off to provisioning. No desktop stack lives here.

debootstrap
cryptsetup
parted
gdisk
dosfstools
e2fsprogs
rsync
curl
git
ca-certificates
console-setup
efibootmgr
network-manager
wpasupplicant
iw

# wifi firmware bundle for the live environment (matches the target's bundle
# in install.sh) — the installer's own wifi must work on any machine.
firmware-realtek
firmware-iwlwifi
firmware-atheros
firmware-brcm80211
firmware-mediatek

systemd-timesyncd

# tput, for the installer's nightshadeNeon frame renderer
ncurses-bin
