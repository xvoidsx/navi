#!/usr/bin/env bash
#
# navi-install — the navi system installer (Mika RC4)
#     by rav3ndust.xyz (xvoidsx)
#
# Boots from the navi installer ISO (root autologin on tty1) and installs
# navi to a disk: GPT layout, bios_grub + EFI system partition, one
# LUKS2-encrypted root (ext4), Debian 13 (trixie) via debootstrap, kernel +
# GRUB with cryptodisk support so the LUKS passphrase prompt appears at boot.
#
# Boots on UEFI and legacy BIOS: the disk gets both an EFI system partition
# and a bios_grub partition, and GRUB is installed for both targets.
#
# Network: the installer downloads Debian mid-install and first boot
# provisions the wired — both need the machine online. Ethernet (DHCP)
# just works; otherwise the installer offers WiFi (scan, pick, password)
# and carries the profile into the installed system.
#
# Hard separation, by design:
#   THIS script does partitioning, filesystems, LUKS, debootstrap, users,
#   bootloader/initramfs, and the handoff. Everything else — packages,
#   /wired, commands, identity, agents, wallpapers, flatpak, services —
#   is provisioning, and runs from /opt/navi-iso/install.sh --yes as a
#   first-boot systemd service (see installer/navi-provision).
#
# Run as root on the installer ISO. UEFI and legacy BIOS both work (x86_64).

set -euo pipefail

# ============================== toggles ==============================
# SDDM autologin for the installed user once provisioning finishes.
# "yes": first boot goes LUKS prompt -> wired desktop, no login screen.
# "no":  first boot goes LUKS prompt -> SDDM login, user types password.
AUTOLOGIN="yes"

HOSTNAME="navi"            # hostname for the installed system
TARGET="/mnt/navi"         # where the new system is assembled
ISO_ROOT="/opt/navi-iso"   # navi payload shipped on the ISO
MAPPER_NAME="cryptroot"    # dm-crypt name for the LUKS root
# =====================================================================

# ---------------------------------------------------------------- ui

banner() {
  cat <<'EOF'

                       ∅

         ✦  w e l c o m e   t o   n a v i !  ✦

              1 . 2   " m i k a "   R C 3

            the wired will provide.


EOF
}

step() { echo; echo "──▶ $1"; }
ok()   { echo "    ✓ $1"; }
info() { echo "    · $1"; }
die()  { echo "    ✗ $1" >&2; exit 1; }

# ---------------------------------------------------------------- preflight

preflight() {
  [ "$EUID" -eq 0 ] || die "run as root (this installer owns the disks)."

  # UEFI and legacy BIOS both work — the disk layout below boots either way.
  if [ -d /sys/firmware/efi ]; then
    BOOT_MODE="UEFI"
  else
    BOOT_MODE="legacy BIOS"
  fi

  local t
  for t in debootstrap cryptsetup parted mkfs.fat mkfs.ext4 blkid nmcli curl; do
    command -v "$t" >/dev/null 2>&1 || die "missing tool: $t (broken installer ISO)."
  done

  [ -f "$ISO_ROOT/install.sh" ] && [ -d "$ISO_ROOT/wired" ] \
    || die "$ISO_ROOT is missing install.sh/wired (broken installer ISO)."

  ok "preflight: root, $BOOT_MODE boot, tools, navi payload"
}

# ---------------------------------------------------------------- network
#
# The installer downloads Debian mid-install and first boot provisions the
# wired — both need the machine online. Ethernet (DHCP) just works; for
# WiFi we connect here with NetworkManager and carry the profile into the
# installed system so first boot is already online.

net_is_up() {
  # TCP-level check against the same mirror debootstrap uses.
  curl -sI --max-time 8 http://deb.debian.org/debian/ >/dev/null 2>&1
}

net_describe() {
  local dev
  dev="$(ip -o route get 1.1.1.1 2>/dev/null | awk '{print $5; exit}')"
  [ -n "$dev" ] && echo "via $dev" || echo "link up"
}

wifi_iface() {
  nmcli -t -f DEVICE,TYPE dev 2>/dev/null | awk -F: '$2=="wifi" {print $1; exit}'
}

wifi_available() {
  [ -n "$(wifi_iface)" ]
}

wifi_connect() {
  local ifname ssid pass try
  ifname="$(wifi_iface)"
  [ -n "$ifname" ] || { echo "    no WiFi radio found."; return 1; }

  echo "    scanning for networks…"
  nmcli dev wifi rescan ifname "$ifname" >/dev/null 2>&1 || true
  sleep 4

  local i=0
  declare -a NETS=()
  while IFS= read -r ssid; do
    [ -n "$ssid" ] && [ "$ssid" != "--" ] || continue
    NETS+=("$ssid")
    i=$((i+1))
    printf '    [%d] %s\n' "$i" "$ssid"
    [ "$i" -ge 20 ] && break
  done < <(nmcli -t -f SSID dev wifi list ifname "$ifname" 2>/dev/null | awk '!seen[$0]++')

  [ "${#NETS[@]}" -gt 0 ] || { echo "    no networks found in range."; return 1; }
  echo "    [0] type the network name manually (hidden network)"

  local choice
  while true; do
    read -r -p "    network number: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 0 ] && [ "$choice" -le "${#NETS[@]}" ]; then
      break
    fi
    echo "    pick 0–${#NETS[@]}."
  done
  if [ "$choice" -eq 0 ]; then
    read -r -p "    network name (SSID): " ssid
    [ -n "$ssid" ] || { echo "    empty network name."; return 1; }
  else
    ssid="${NETS[$((choice-1))]}"
  fi

  read -r -s -p "    password for '$ssid' (empty for open networks): " pass; echo

  for try in 1 2 3; do
    echo "    connecting (attempt $try/3)…"
    if [ -n "$pass" ]; then
      nmcli dev wifi connect "$ssid" password "$pass" ifname "$ifname" >/dev/null 2>&1
    else
      nmcli dev wifi connect "$ssid" ifname "$ifname" >/dev/null 2>&1
    fi
    if net_is_up; then
      ok "joined '$ssid'"
      unset pass
      return 0
    fi
    echo "    didn't connect — wrong password?"
  done
  unset pass
  return 1
}

setup_network() {
  step "network"

  # NetworkManager drives both wired and wireless on the live ISO.
  if command -v nmcli >/dev/null 2>&1; then
    systemctl start NetworkManager 2>/dev/null || true
    sleep 2
  fi

  if net_is_up; then
    ok "already online $(net_describe) — carrying on"
    return 0
  fi

  echo "    no connection yet. the installer downloads Debian as it works,"
  echo "    and first boot provisions the wired — both need you online."
  echo

  if wifi_available; then
    local ans
    read -r -p "    no wired link — set up WiFi instead? [Y/n] " ans
    case "${ans:-Y}" in
      [Yy]*) wifi_connect || die "couldn't get online — plug in ethernet and re-run." ;;
      *) die "offline — plug in ethernet and re-run the installer." ;;
    esac
  else
    die "offline and no WiFi radio detected — plug in ethernet and re-run."
  fi

  net_is_up || die "still offline — re-check the password/cable and re-run."
  ok "online $(net_describe)"
}

# Carry live-ISO network profiles (WiFi passphrases included) into the
# installed system, so first boot is online for provisioning. The profiles
# live on the LUKS-encrypted root, guarded by the disk passphrase.
persist_network() {
  local src=/etc/NetworkManager/system-connections
  [ -d "$src" ] || return 0
  local files=( "$src"/*.nmconnection )
  [ -e "${files[0]}" ] || return 0
  mkdir -p "$TARGET/etc/NetworkManager/system-connections"
  cp -a "$src"/*.nmconnection "$TARGET/etc/NetworkManager/system-connections/"
  chmod 600 "$TARGET"/etc/NetworkManager/system-connections/*.nmconnection
  ok "network profile(s) carried into the installed system (${#files[@]} file(s))"
}

# ---------------------------------------------------------------- disk selection

pick_disk() {
  step "disk selection"
  echo "    available disks:"
  # NOTE: NAME,TYPE only — MODEL can contain spaces, which breaks field parsing
  mapfile -t DISKS < <(lsblk -dnp -o NAME,TYPE | awk '$2=="disk" {print $1}')
  [ "${#DISKS[@]}" -gt 0 ] || die "no disks found."

  local i
  for i in "${!DISKS[@]}"; do
    printf '    [%d] %s %s\n' "$((i+1))" "${DISKS[$i]}" \
      "$(lsblk -rn -o SIZE,MODEL "${DISKS[$i]}")"
  done

  local choice
  while true; do
    read -r -p "    install navi to disk number: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#DISKS[@]}" ]; then
      DISK="${DISKS[$((choice-1))]}"
      break
    fi
    echo "    pick a number between 1 and ${#DISKS[@]}."
  done
  ok "target disk: $DISK"

  echo
  echo "    !!!  ALL DATA ON $DISK WILL BE DESTROYED  !!!"
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MODEL "$DISK"
  echo
  local confirm
  read -r -p "    type YES in capitals to continue: " confirm
  [ "$confirm" = "YES" ] || die "aborted — nothing was touched."
  ok "destructive confirmation accepted"
}

# ---------------------------------------------------------------- credentials

read_secret_twice() { # <prompt> <var> — reads twice, must match + non-empty
  local prompt="$1" var="$2" a b
  while true; do
    read -r -s -p "    $prompt: " a; echo
    read -r -s -p "    again: " b; echo
    if [ -z "$a" ]; then echo "    must not be empty — try again."; continue; fi
    if [ "$a" != "$b" ]; then echo "    mismatch — try again."; continue; fi
    if [[ "$a" == *:* ]]; then echo "    may not contain ':' — try again."; continue; fi
    printf -v "$var" '%s' "$a"
    return 0
  done
}

get_credentials() {
  step "user + hostname + encryption"
  while true; do
    read -r -p "    username: " NAVI_USER
    if [[ "$NAVI_USER" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && [ "$NAVI_USER" != "root" ]; then
      break
    fi
    echo "    lowercase letters, digits, _ or -, may not be root."
  done

  read_secret_twice "password for $NAVI_USER" USER_PASS

  # hostname: the machine gets a name. default is just "navi".
  while true; do
    read -r -p "    hostname [navi]: " h
    h="${h:-navi}"
    if [[ "$h" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
      HOSTNAME="$h"
      break
    fi
    echo "    lowercase letters, digits, hyphens; must start and end alphanumeric."
  done

  # LUKS passphrase: strength matters here, it guards the whole disk.
  while true; do
    read_secret_twice "disk encryption passphrase (min 8 chars)" LUKS_PASS
    if [ "${#LUKS_PASS}" -ge 8 ]; then break; fi
    echo "    too short — the passphrase guards the entire disk."
  done
  ok "user $NAVI_USER on $HOSTNAME + encryption passphrase set"
}

# ---------------------------------------------------------------- partitioning

partition_disk() {
  step "partitioning $DISK (GPT: bios_grub + EFI + LUKS root)"

  # make sure nothing on the disk is mounted or mapped
  umount -R "$TARGET" 2>/dev/null || true
  cryptsetup close "$MAPPER_NAME" 2>/dev/null || true
  swapoff -a 2>/dev/null || true

  # One layout boots everywhere: a tiny bios_grub partition lets legacy BIOS
  # GRUB embed its core image, the ESP serves UEFI, and the rest is LUKS.
  parted -s "$DISK" mklabel gpt
  parted -s "$DISK" mkpart primary 1MiB 3MiB
  parted -s "$DISK" set 1 bios_grub on
  parted -s "$DISK" mkpart ESP fat32 3MiB 515MiB
  parted -s "$DISK" set 2 esp on
  parted -s "$DISK" mkpart primary 515MiB 100%
  partprobe "$DISK"
  sleep 2

  # nvme0n1 -> nvme0n1p1 ; sda -> sda1
  local suffix=""
  if [[ "$DISK" =~ [0-9]$ ]]; then suffix="p"; fi
  ESP_PART="${DISK}${suffix}2"
  ROOT_PART="${DISK}${suffix}3"
  [ -b "$ESP_PART" ] && [ -b "$ROOT_PART" ] \
    || die "partitions did not appear ($ESP_PART / $ROOT_PART)."

  ok "bios_grub: ${DISK}${suffix}1 · EFI: $ESP_PART · root: $ROOT_PART"
}

format_encrypt() {
  step "encrypting + formatting"

  # PBKDF2, not argon2: GRUB unlocks /boot from the encrypted root and GRUB
  # cannot do argon2. iter-time 5000ms keeps the GRUB unlock delay sane.
  printf '%s' "$LUKS_PASS" | cryptsetup luksFormat \
    --type luks2 --pbkdf pbkdf2 --iter-time 5000 -q "$ROOT_PART" --key-file -
  printf '%s' "$LUKS_PASS" | cryptsetup open \
    "$ROOT_PART" "$MAPPER_NAME" --key-file -
  unset LUKS_PASS
  ok "LUKS2 (pbkdf2) on $ROOT_PART, open as $MAPPER_NAME"

  mkfs.ext4 -q -L navi-root "/dev/mapper/$MAPPER_NAME"
  mkfs.fat -F32 -n NAVI-EFI "$ESP_PART" >/dev/null
  ok "ext4 root + FAT32 EFI system partition"

  LUKS_UUID="$(blkid -s UUID -o value "$ROOT_PART")"
  ROOT_UUID="$(blkid -s UUID -o value "/dev/mapper/$MAPPER_NAME")"
  ESP_UUID="$(blkid -s UUID -o value "$ESP_PART")"
}

mount_target() {
  step "mounting target"
  mkdir -p "$TARGET"
  mount "/dev/mapper/$MAPPER_NAME" "$TARGET"
  mkdir -p "$TARGET/boot/efi"
  mount "$ESP_PART" "$TARGET/boot/efi"
  ok "target at $TARGET"
}

# ---------------------------------------------------------------- base system

run_debootstrap() {
  step "debootstrap Debian 13 (trixie)"
  local attempt
  for attempt in 1 2; do
    if debootstrap \
      --arch=amd64 \
      --components=main,contrib,non-free,non-free-firmware \
      --include=linux-image-amd64,grub-efi-amd64,grub-pc,efibootmgr,cryptsetup,cryptsetup-initramfs,initramfs-tools,opendoas,network-manager,wpasupplicant,console-setup,ca-certificates,firmware-linux \
      trixie "$TARGET" http://deb.debian.org/debian; then
      ok "base system installed"
      return 0
    fi
    [ "$attempt" = "1" ] && info "debootstrap failed — one retry (flaky network?)"
  done
  die "debootstrap failed twice — check the network and the clock (date -u), then re-run."
}

# ---------------------------------------------------------------- chroot configuration

configure_target() {
  step "configuring the installed system"

  mount --bind /dev  "$TARGET/dev"
  mount --bind /proc "$TARGET/proc"
  mount --bind /sys  "$TARGET/sys"
  mount --bind /run  "$TARGET/run"
  cp /etc/resolv.conf "$TARGET/etc/resolv.conf"

  # navi payload -> the target, where first-boot provisioning finds it
  mkdir -p "$TARGET/opt/navi-iso"
  cp -a "$ISO_ROOT"/. "$TARGET/opt/navi-iso/"
  ok "navi payload -> /opt/navi-iso"

  # user password, via a locked-down file (never on a command line)
  printf '%s:%s' "$NAVI_USER" "$USER_PASS" > "$TARGET/root/.navi-user-pass"
  chmod 600 "$TARGET/root/.navi-user-pass"
  unset USER_PASS

  # the chroot script: static body (quoted heredoc) + sed-injected values.
  # all injected values are charset-validated above, so sed is safe.
  cat > "$TARGET/root/navi-chroot-setup.sh" <<'CHROOT_EOF'
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

echo "  [chroot] package lists"
apt-get update -qq

echo "  [chroot] hostname"
echo "@HOSTNAME@" > /etc/hostname
cat > /etc/hosts <<'EOF'
127.0.0.1 localhost
127.0.1.1 @HOSTNAME@
::1 localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF

echo "  [chroot] crypttab + fstab"
echo "@MAPPER_NAME@ UUID=@LUKS_UUID@ none luks,discard" > /etc/crypttab
cat > /etc/fstab <<'EOF'
UUID=@ROOT_UUID@ / ext4 errors=remount-ro 0 1
UUID=@ESP_UUID@ /boot/efi vfat umask=0077 0 1
EOF

echo "  [chroot] GRUB with cryptodisk (unlocks /boot inside LUKS)"
sed -i 's/^#\?GRUB_ENABLE_CRYPTODISK=.*/GRUB_ENABLE_CRYPTODISK=y/' /etc/default/grub

echo "  [chroot] navi boot branding (menu says navi, not Debian)"
sed -i 's/^#\?GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR=navi/' /etc/default/grub
grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub \
  || echo 'GRUB_DISTRIBUTOR=navi' >> /etc/default/grub
sed -i 's/^#\?GRUB_TIMEOUT=.*/GRUB_TIMEOUT=5/' /etc/default/grub
if [ -f /opt/navi-iso/wired/wp/SElain3.jpg ]; then
  cp /opt/navi-iso/wired/wp/SElain3.jpg /boot/grub/navi-bg.jpg
  grep -q '^GRUB_BACKGROUND=' /etc/default/grub \
    && sed -i 's|^GRUB_BACKGROUND=.*|GRUB_BACKGROUND=/boot/grub/navi-bg.jpg|' /etc/default/grub \
    || echo 'GRUB_BACKGROUND=/boot/grub/navi-bg.jpg' >> /etc/default/grub
fi

echo "  [chroot] user"
useradd -m -s /bin/bash "@NAVI_USER@"
chpasswd < /root/.navi-user-pass
shred -u /root/.navi-user-pass
passwd -l root

echo "  [chroot] doas (temporary nopass rule for first-boot provisioning;"
echo "           navi-provision locks this down to 'persist' when done)"
printf 'permit nopass %s as root\n' "@NAVI_USER@" > /etc/doas.conf
chmod 644 /etc/doas.conf

echo "  [chroot] first-boot provisioning service"
install -m 0755 /opt/navi-iso/installer/navi-provision /usr/local/bin/navi-provision
install -m 0644 /opt/navi-iso/installer/navi-provision.service \
  /etc/systemd/system/navi-provision.service
printf 'NAVI_USER=%s\nNAVI_AUTOLOGIN=%s\n' "@NAVI_USER@" "@AUTOLOGIN@" > /etc/navi-install.conf
chmod 644 /etc/navi-install.conf
systemctl enable navi-provision.service
systemctl set-default graphical.target
systemctl enable NetworkManager-wait-online.service

echo "  [chroot] bootloader (legacy BIOS + UEFI) + initramfs"
# MBR for legacy BIOS: always written, harmless on UEFI-only machines.
grub-install --target=i386-pc --bootloader-id=navi --recheck "@DISK@"
# EFI boot entry: only when the installer itself booted via UEFI,
# because efibootmgr needs UEFI runtime to register it.
if [ -d /sys/firmware/efi ]; then
  grub-install --target=x86_64-efi --efi-directory=/boot/efi \
    --bootloader-id=navi --recheck
fi
update-grub
update-initramfs -u -k all

echo "  [chroot] done"
CHROOT_EOF

  sed -i \
    -e "s/@HOSTNAME@/$HOSTNAME/g" \
    -e "s/@MAPPER_NAME@/$MAPPER_NAME/g" \
    -e "s/@LUKS_UUID@/$LUKS_UUID/g" \
    -e "s/@ROOT_UUID@/$ROOT_UUID/g" \
    -e "s/@ESP_UUID@/$ESP_UUID/g" \
    -e "s/@NAVI_USER@/$NAVI_USER/g" \
    -e "s/@AUTOLOGIN@/$AUTOLOGIN/g" \
    -e "s|@DISK@|$DISK|g" \
    "$TARGET/root/navi-chroot-setup.sh"
  chmod 700 "$TARGET/root/navi-chroot-setup.sh"

  chroot "$TARGET" /bin/bash /root/navi-chroot-setup.sh
  rm -f "$TARGET/root/navi-chroot-setup.sh"
  ok "target configured: $HOSTNAME, user $NAVI_USER, GRUB, initramfs"
}

# ---------------------------------------------------------------- teardown

teardown() {
  step "unmounting"
  umount -R "$TARGET" 2>/dev/null || true
  cryptsetup close "$MAPPER_NAME" 2>/dev/null || true
  sync
  ok "disks synced, LUKS closed"
}

# ---------------------------------------------------------------- clock
# Package signatures are time-sensitive. Old laptops (the machines navi
# loves most) often have dead CMOS batteries and boot thinking it is 2013 —
# debootstrap then dies with "Invalid Release signature". Sync before we
# trust the network for packages.
clock_sane() {
  local y
  y="$(date -u +%Y 2>/dev/null)"
  [ "$y" -ge 2024 ] && [ "$y" -le 2035 ]
}

sync_clock() {
  step "syncing clock (package signatures need the right time)"

  # timesyncd is the normal path on the live image
  if command -v timedatectl >/dev/null 2>&1; then
    systemctl start systemd-timesyncd 2>/dev/null || true
    timedatectl set-ntp true 2>/dev/null || true
    local i
    for i in $(seq 1 30); do
      timedatectl show 2>/dev/null | grep -q "NTPSynchronized=yes" && break
      sleep 2
    done
  fi

  # fallback: steal the time from an HTTP Date header — setup_network just
  # proved deb.debian.org is reachable
  if ! clock_sane; then
    local hdr
    hdr="$(curl -sI --max-time 15 http://deb.debian.org/debian/ \
             | grep -i '^date:' | cut -d' ' -f2- | tr -d '\r')"
    if [ -n "$hdr" ]; then
      date -u -s "$hdr" 2>/dev/null || true
      info "clock set from network time"
    fi
  fi

  if clock_sane; then
    ok "clock: $(date -u '+%Y-%m-%d %H:%M UTC')"
  else
    die "clock is still wrong ($(date -u)) and time sync failed — package signatures will not verify. Set it by hand: date -u -s 'YYYY-MM-DD HH:MM:SS'"
  fi
}

# ---------------------------------------------------------------- main

main() {
  banner
  preflight
  setup_network
  sync_clock
  pick_disk
  get_credentials
  partition_disk
  format_encrypt
  mount_target
  run_debootstrap
  configure_target
  persist_network
  teardown

  # don't offer the installer again on this boot's root shell
  touch /tmp/navi-install.done

  cat <<EOF

  ╔══════════════════════════════════════════════════════════════╗
  ║                                                              ║
  ║   ✓  navi 1.2 "mika" RC4 is installed.                      ║
  ║                                                              ║
  ║   remove the ISO and reboot.                                 ║
  ║   1. enter your disk encryption passphrase at the prompt     ║
  ║   2. first boot provisions the wired (takes a while —        ║
  ║      packages, agents, wallpapers; needs network)             ║
  ║   3. you land directly in the wired. welcome home.           ║
  ║                                                              ║
  ╚══════════════════════════════════════════════════════════════╝

EOF
  local ans
  read -r -p "    reboot now? [Y/n] " ans
  case "${ans:-Y}" in [Yy]*) reboot ;; *) echo "    reboot when ready: reboot";; esac
}

main "$@"
