#!/usr/bin/env bash
#
# navi-provision — first-boot provisioning for navi (Mika RC1)
#     by rav3ndust.xyz (xvoidsx)
#
# Runs once as root via navi-provision.service, before the login manager:
#   1. runs /opt/navi-iso/install.sh --yes as the installed user
#      (packages, /wired, commands, identity, agents, wallpapers, flatpak)
#   2. optionally writes the SDDM autologin drop-in (see AUTOLOGIN in
#      navi-install — install.sh overwrites sddm/navi.conf, so autologin
#      lives in this separate drop-in file instead)
#   3. locks doas down: the temporary nopass rule used for provisioning is
#      replaced with the normal 'permit persist' rule
#   4. disables itself and starts sddm
#
# If provisioning fails, the service fails and boot continues to a getty:
# log in as the installed user and run /opt/navi-iso/install.sh --yes
# by hand, then `doas systemctl start sddm`.

set -euo pipefail

CONF="/etc/navi-install.conf"

log() { echo "navi-provision: $*"; }

[ -f "$CONF" ] || { log "$CONF missing — nothing to do."; exit 0; }
# shellcheck disable=SC1090
. "$CONF"   # NAVI_USER, NAVI_AUTOLOGIN
[ -n "${NAVI_USER:-}" ] || { log "NAVI_USER empty — aborting."; exit 1; }

log "provisioning the wired as $NAVI_USER (this takes a while — packages,"
log "agents, wallpapers; the machine needs network access)"

# install.sh refuses root: run it as the installed user with a clean env.
runuser -u "$NAVI_USER" -- env -i \
  HOME="/home/$NAVI_USER" USER="$NAVI_USER" LOGNAME="$NAVI_USER" \
  PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
  SHELL="/bin/bash" \
  bash /opt/navi-iso/install.sh --yes

if [ "${NAVI_AUTOLOGIN:-yes}" = "yes" ]; then
  install -d -m 755 /etc/sddm.conf.d
  cat > /etc/sddm.conf.d/10-navi-autologin.conf <<EOF
# generated by navi-provision — SDDM autologin for the installed user.
# delete this file to get the password login screen back.
[Autologin]
User=$NAVI_USER
Session=navi.desktop
EOF
  chmod 644 /etc/sddm.conf.d/10-navi-autologin.conf
  log "SDDM autologin enabled for $NAVI_USER"
else
  log "autologin off — SDDM will ask for a password"
fi

# provisioning is done: the nopass rule has served its purpose.
printf 'permit persist %s as root\n' "$NAVI_USER" > /etc/doas.conf
chmod 644 /etc/doas.conf
log "doas locked down to 'permit persist'"

systemctl disable navi-provision.service >/dev/null 2>&1 || true
log "provisioning complete — starting the login manager"
systemctl start sddm.service
