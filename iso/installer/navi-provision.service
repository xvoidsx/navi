# navi-provision.service — first-boot provisioning for navi (Mika RC1)
#
# Runs /usr/local/bin/navi-provision once, before the login manager.
# The installer (navi-install) enables this; navi-provision disables it
# when provisioning succeeds. Reads /etc/navi-install.conf for the
# installed username and the autologin toggle.

[Unit]
Description=navi first-boot provisioning (Mika RC1)
After=network-online.target
Wants=network-online.target
Before=sddm.service display-manager.service
ConditionPathExists=/etc/navi-install.conf

[Service]
Type=oneshot
ExecStart=/usr/local/bin/navi-provision
# package installs + mpvpaper build + downloads: allow as long as it takes
TimeoutStartSec=infinity
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
